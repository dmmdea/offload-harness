# __SEAT_ID__.env — the vLLM seat's operating point, RENDERED from the tier table.
#
# Do not hand-edit this file. Every value below is a measured operating point recorded in
# setup/templates/profiles.json under the tier's `vllm_seat`; editing it here makes the box
# disagree with the tier it claims to be, which is the exact drift this rendering exists to end.
# Change the tier, re-run `local-offload install vllm-seat`, and copy the result into the distro.
#
# Read by __WSL_SEAT_DIR__/seat_fg.sh (start) and __WSL_SEAT_DIR__/seat_stop.sh (stop) inside the
# WSL distro `__DISTRO__`.

SEAT_NAME=__SEAT_ID__
SEAT_ALIAS=__POOL_ALIAS__
SEAT_PORT=__PORT__
SEAT_MP_PORT=__MP_PORT__

# Cards and layout. SEAT_DEVICES is CUDA_VISIBLE_DEVICES under CUDA_DEVICE_ORDER=PCI_BUS_ID, so it
# is PCI order and NOT the order any other tool reports. SEAT_TP must equal how many cards are
# listed: the tier schema refuses the pair when it does not.
SEAT_DEVICES=__DEVICE__
SEAT_TP=__TENSOR_PARALLEL__

SEAT_MAX_LEN=__MAX_MODEL_LEN__
SEAT_UTIL=__GPU_UTIL__
SEAT_SEQS=__MAX_NUM_SEQS__
SEAT_BATCHED=__MAX_BATCHED__

# LMCache. SEAT_CHUNK is in TOKENS and MUST equal the engine's unified block size for this model at
# this KV dtype — a mismatch fails registration at start, and a merely stale value halves reuse
# while reporting success. SEAT_L1_GB is the pinned host staging buffer beside the engine, not the
# tier itself. An empty SEAT_L2 means no cache server: VRAM plus L1 only, which is supported.
SEAT_L1_GB=__L1_GB__
SEAT_CHUNK=__CHUNK__
SEAT_L2='__L2_JSON__'

# The export the wrapper mounts before the MP server starts, and the write floor it must clear.
# The floor is what makes a LAN store safe to depend on: the same export measured 570 MB/s wired,
# 124 through WireGuard and 4.6 over Wi-Fi, and without a floor the seat silently ran at the slow
# rate — far below the parity the tier is justified by. A mount under the floor is REFUSED.
SEAT_L2_MOUNT_SRC=__MOUNT_SRC__
SEAT_L2_MOUNT_DIR=__MOUNT_DIR__
SEAT_L2_MOUNT_OPTS=__MOUNT_OPTS__
SEAT_L2_MIN_MBPS=__MIN_MBPS__

# Pruned at seat START, because LMCache's own eviction counts only pages the RUNNING MP server
# wrote (upstream F10): pages from a previous run are invisible to it and accumulate. Under real
# fan-out the reference store went 28 -> 99 GB against a 100 GB quota in 75 minutes, and a dataset
# AT its quota can refuse the very deletes that would free it.
SEAT_L2_PRUNE_GB=__PRUNE_GB__

# A patched LMCache on PYTHONPATH for the MP server and the engine. REQUIRED when the KV dtype is
# fp8: stock LMCache restores fp8 pages corrupt (upstream PR #4253) and reports success while doing
# it. The renderer refuses that pair rather than emit a seat that serves wrong context silently.
SEAT_LMCACHE_PYTHONPATH=__LMCACHE_OVERLAY__

SEAT_HF_HOME=__HF_HOME__

# Tool calling is not optional for an agent seat and the flags travel together: the harness agent
# loop sends tool_choice=auto and vLLM answers 400 unless --enable-auto-tool-choice AND a parser
# are both present. The reasoning parser keeps <think> text out of the answer.
SEAT_EXTRA_ARGS="__EXTRA_ARGS__"
