+def get_min_payload_count(req_type: RequestType) -> int:
+    """
+    HOUSE-PP-REGISTER-BIND 2026-09-22: the fewest payloads a request of this
+    type may carry: ``len(payload_classes)`` minus the request type's declared
+    ``optional_trailing_payloads`` (0 for every type that did not opt in).
