# vllm-seat.service — the vLLM agent seat engine (reference: NVIDIA A2 16 GB, `ampere-16`, 2026-09-06; ADR 0035).
# NOT ENABLED AT BOOT, AND IT MUST NOT BE. llama-swap owns this unit's lifetime through vllm-seat-cmd.sh /
# vllm-seat-cmdstop.sh, so the seat loads on first use and is stopped when llama-swap idles it out. A boot-enabled
# unit outlives its own front door: llama-swap's TTL can only unload what llama-swap started, so an enabled unit
# holds the card forever no matter what ttl says — measured on the reference A2 at 10,338 of 15,356 MiB while idle.
# Restart=on-failure. Binds the TAILSCALE address (the tailnet is the trust boundary, like the fleet
# node) — llama-swap's entry proxies to it and owns load/unload through vllm-seat-cmd*.sh (polkit rule
# 50-llama-swap-vllm-seat.rules). Launch line + rationale: vllm-seat-run.sh.
# RENDERED, not hand-edited, since 0.113.33: `local-offload install vllm-seat` substitutes the double-underscore tokens
# below from the tier's vllm_seat spec in setup/templates/profiles.json plus the deployment's own paths. Edit the SPEC
# (or this file's shape), never a rendered copy — the renderer REFUSES to emit a file that still holds a token.
[Unit]
Description=vLLM agent seat (__SEAT_ID__ / __POOL_ALIAS__, :__PORT__ Tailscale)
# Wants (not Requires) tailscaled: a tailscaled restart (package upgrade) must not restart the seat behind llama-swap's back —
# the bound Tailscale address survives it; the run script waits for the address at boot.
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__STACK_DIR__
ExecStart=__SEAT_DIR__/vllm-seat-run.sh
Restart=on-failure
RestartSec=20
TimeoutStopSec=90
KillMode=mixed
StandardOutput=append:__STACK_DIR__/logs/__UNIT__.log
StandardError=append:__STACK_DIR__/logs/__UNIT__.log

# NO [Install] SECTION ON PURPOSE. Without WantedBy= the unit cannot be enabled at boot, which is what keeps its
# lifetime in llama-swap's hands. `systemctl enable` on this unit is a defect, not a deployment step.
