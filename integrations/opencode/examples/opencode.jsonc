{
  // Example ~/.config/opencode/opencode.jsonc for full local-offload harness support.
  // Adjust the two absolute paths and the provider baseURL to your box.
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen3.8-27b",
  "small_model": "llamacpp/gemma-4-e4b",

  // House rules parity: every ~/.claude/rules/*.md auto-loads. Do NOT add a global
  // ~/.config/opencode/AGENTS.md if you rely on ~/.claude/CLAUDE.md — it would replace it.
  "instructions": ["C:/Users/you/.claude/rules/*.md"],

  // The harness MCP: the same launch Claude Code uses. Keys come from the environment.
  "mcp": {
    "harness": {
      "type": "local",
      "command": ["C:/path/to/local-offload.exe", "mcp", "--config", "C:/path/to/config.json"],
      "environment": { "NVIDIA_API_KEY": "{env:NVIDIA_API_KEY}" },
      "enabled": true,
      "timeout": 600000
    }
  },

  // The plugin (loader in ~/.config/opencode/plugins/opencode-local-offload.ts, or, from npm:)
  // "plugin": [["opencode-local-offload", { "routeReadOnlyTasks": true }]],

  // The plugin's config hook provides these too; declared so the task tool validates the name
  // even before the plugin loads.
  "agent": {
    "offload": {
      "description": "Free local read-only specialist over LOCAL files using the harness tools.",
      "mode": "subagent",
      "model": "llamacpp/qwen3.8-27b",
      "permission": { "edit": "deny", "bash": "deny", "webfetch": "deny", "external_directory": "allow" }
    }
  },

  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-swap",
      "options": { "baseURL": "http://localhost:11436/v1", "apiKey": "local" },
      "models": {
        "qwen3.8-27b": { "name": "Qwen3.8 27B", "tool_call": true, "limit": { "context": 131072, "output": 32768 } },
        "gemma-4-12b": { "name": "Gemma 4 12B", "tool_call": true, "limit": { "context": 131072, "output": 32768 } },
        "gemma-4-e4b": { "name": "Gemma 4 E4B", "tool_call": true, "limit": { "context": 131072, "output": 32768 } }
      }
    }
  }
}
