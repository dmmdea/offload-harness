{
 "_comment": "What the Axera AX650 lane runs. Files and sources only: no version, commit or digest (ADR 0099). fetch_models.py resolves each repository's current commit and each GitHub release at run time, checks every file against the publisher's digest, and records what it installed in <home>/models/models.installed.json and <home>/runtime.installed.json. Every model here was compiled for the AX650 NPU (the AX8850 card carries the same NPU) by its publisher; licence is the upstream weights' licence, not the conversion repository's tag; tools names the sidecar tools that load the model.",
 "sources": {
  "huggingface": {
   "api": "https://huggingface.co/api/models/{repo}",
   "tree": "https://huggingface.co/api/models/{repo}/tree/{rev}?recursive=true",
   "file": "https://huggingface.co/{repo}/resolve/{rev}/{path}"
  }
 },
 "runtime": {
  "pyaxengine": {"github": "AXERA-TECH/pyaxengine", "asset": "axengine-*-py3-none-any.whl", "dest": "wheels",
                 "use": "the Python binding of the AXCL runtime the sidecar loads every model through"}
 },
 "models": {
  "rfdetr-s": {"repo": "AXERA-TECH/rf-detr-small", "licence": "Apache-2.0", "tools": ["object_detect", "segment", "pose"],
               "files": ["models/rf-detr-small.axmodel", "models/preprocessor_config.json", "models/rfdetr_small_512_b2_post.onnx"]},
  "siglip2-b16-224": {"repo": "AXERA-TECH/siglip2-base-patch16-224", "licence": "Apache-2.0",
                      "tools": ["classify", "embed", "text_embed", "zero_shot"],
                      "files": ["ax650/siglip2-base-patch16-224_vision.axmodel", "ax650/siglip2-base-patch16-224_text.axmodel",
                                "tokenizer/tokenizer.json", "tokenizer/tokenizer_config.json", "tokenizer/special_tokens_map.json",
                                "tokenizer/preprocessor_config.json", "config.json"]},
  "ppocr-v5": {"repo": "AXERA-TECH/PPOCR_v5", "licence": "Apache-2.0", "tools": ["ocr"],
               "files": ["ax650/det_npu3.axmodel", "ax650/rec_npu3.axmodel", "ax650/cls_npu3.axmodel", "ppocrv5_dict.txt",
                         "det.json", "rec.json", "cls.json"]},
  "depth-anything-3-s": {"repo": "AXERA-TECH/Depth-Anything-3", "licence": "Apache-2.0", "tools": ["depth"],
                         "files": ["models-ax650/da3-small.axmodel"]},
  "rtmpose-m": {"repo": "AXERA-TECH/RTMPose", "licence": "Apache-2.0", "tools": ["pose"],
                "files": ["AX650/rtmpose_m_npu3.axmodel"]},
  "mobilesam": {"repo": "AXERA-TECH/MobileSAM", "licence": "Apache-2.0", "tools": ["segment"],
                "files": ["ax_model/mobile_sam_encoder_650.axmodel", "ax_model/mobile_sam_decoder_650.axmodel"]},
  "deeplabv3plus": {"repo": "AXERA-TECH/DeepLabv3Plus", "licence": "MIT", "tools": ["semantic_segment"],
                    "files": ["models-ax650/deeplabv3plus_mobilenet_u16.axmodel"]}
 }
}
