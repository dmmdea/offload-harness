  "ComfyMathExpression": {
    "input": {
      "required": {
        "expression": ["STRING", { "default": "a + b", "multiline": true }],
        "values": ["COMFY_AUTOGROW_V3", { "template": { "input": { "required": { "value": ["FLOAT,INT,BOOLEAN", {}] } }, "names": ["a", "b", "c", "d"], "min": 1 } }]
      }
    },
    "input_order": { "required": ["expression", "values"] },
    "output": ["FLOAT", "INT", "BOOLEAN"], "output_name": ["FLOAT", "INT", "BOOL"],
    "name": "ComfyMathExpression", "display_name": "Math Expression", "output_node": false
  },
  "DynSampler": {
    "input": {
      "required": {
        "clip": ["CLIP", {}],
        "prompt": ["STRING", { "default": "", "multiline": true }],
        "max_length": ["INT", { "default": 512 }],
        "mode": ["COMFY_DYNAMICCOMBO_V3", {
          "options": [
            { "key": "on", "inputs": {
              "required": {
                "temperature": ["FLOAT", { "default": 0.7 }],
                "top_k": ["INT", { "default": 64 }],
                "seed": ["INT", { "default": 0, "min": 0, "max": 18446744073709551615 }]
              },
              "optional": { "presence_penalty": ["FLOAT", { "default": 0.0 }] }
            } },
            { "key": "off", "inputs": { "required": {} } }
          ]
        }]
      },
      "optional": {
        "image": ["IMAGE", {}],
        "thinking": ["BOOLEAN", { "default": false }]
      }
    },
    "input_order": { "required": ["clip", "prompt", "max_length", "mode"], "optional": ["image", "thinking"] },
    "output": ["STRING"], "output_name": ["generated_text"],
    "name": "DynSampler", "display_name": "Dynamic Sampler", "output_node": false
  },
  "ResizeSynth": {
    "input": {
      "required": {
        "input": ["COMFY_MATCHTYPE_V3", { "template": { "template_id": "input_type", "allowed_types": "IMAGE,MASK" } }],
        "resize_type": ["COMFY_DYNAMICCOMBO_V3", {
          "options": [
            { "key": "scale dimensions", "inputs": { "required": {
              "width": ["INT", { "default": 512 }], "height": ["INT", { "default": 512 }], "crop": ["COMBO", { "options": ["disabled", "center"], "multiselect": false }]
            } } },
            { "key": "scale longer dimension", "inputs": { "required": { "longer_size": ["INT", { "default": 512 }] } } }
          ]
        }],
        "scale_method": [["nearest", "lanczos"]]
      }
    },
    "input_order": { "required": ["input", "resize_type", "scale_method"] },
    "output": ["IMAGE,MASK"], "output_name": ["resized"],
    "name": "ResizeSynth", "display_name": "Resize Synth", "output_node": false
  },
  "NestedDyn": {
    "input": {
      "required": {
        "codec": ["COMFY_DYNAMICCOMBO_V3", {
          "options": [
            { "key": "h264", "inputs": { "required": {
              "encoding": ["COMFY_DYNAMICCOMBO_V3", { "options": [
                { "key": "fast", "inputs": { "required": { "crf": ["INT", { "default": 23 }] } } },
                { "key": "slow", "inputs": { "required": {} } }
              ] }],
              "profile": [["baseline", "main"]]
            } } },
            { "key": "raw", "inputs": { "required": {} } }
          ]
        }],
        "format": [["mp4", "webm"]]
      }
    },
    "input_order": { "required": ["codec", "format"] },
    "output": ["VIDEO"], "output_name": ["VIDEO"],
    "name": "NestedDyn", "display_name": "Nested Dynamic", "output_node": false
  },
