    },
    "resolved_from": {
      "type": "string"
    },
    "header": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer"
        },
        "file_size_mib": {
          "type": "integer"
        },
        "is_gguf": {
          "type": "boolean"
        },
        "not_gguf_reason": {
          "type": "string"
        },
        "magic_seen": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "tensor_count": {
          "type": "integer"
        },
        "kv_count": {
          "type": "integer"
        },
        "metadata_bytes": {
          "type": "integer"
        },
        "architecture": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size_label": {
          "type": "string"
        },
        "block_count": {
          "type": "integer"
        },
        "head_count": {
          "type": "integer"
        },
        "head_count_kv": {
          "type": "integer"
        },
        "context_length": {
          "type": "integer"
        },
        "embedding_length": {
          "type": "integer"
        },
        "head_count_kv_source": {
          "type": "string"
        },
        "key_length": {
          "type": "integer"
        },
        "value_length": {
          "type": "integer"
        },
        "key_value_length_source": {
          "type": "string"
        },
        "sliding_window": {
          "type": "integer"
        },
        "sliding_window_pattern": {
          "type": "array",
          "items": {
            "type": "boolean"
          }
        },
        "key_length_swa": {
          "type": "integer"
        },
        "value_length_swa": {
          "type": "integer"
