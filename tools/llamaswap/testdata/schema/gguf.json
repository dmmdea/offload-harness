          "type": "string"
        },
        "general_type": {
          "type": "string"
        },
        "is_model": {
          "type": "boolean"
        },
        "not_a_model_reason": {
          "type": "string"
        },
        "pooling_type": {
          "type": "integer"
        },
        "pooling_type_name": {
          "type": "string"
        },
        "pooling_role": {
          "type": "string"
        },
        "split": {
          "type": "object",
          "properties": {
            "split_no": {
              "type": "integer"
            },
            "split_count": {
              "type": "integer"
            },
            "split_tensors_count": {
              "type": "integer"
            },
            "shard_index_1_based": {
              "type": "integer"
            },
            "summary": {
              "type": "string"
            },
            "filename_index": {
              "type": "integer"
