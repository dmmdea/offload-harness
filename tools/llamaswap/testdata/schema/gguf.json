        "unsupported_kv_arch": {
          "type": "string"
        },
        "unsupported_kv_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tensor_info_bytes": {
          "type": "integer"
        },
        "tensor_info_error": {
          "type": "string"
        },
        "chat_template_chars": {
          "type": "integer"
        },
        "chat_template_sha256": {
          "type": "string"
        },
        "kv": {
          "type": "object",
          "additionalProperties": {

          }
        }
      },
      "required": ["file_size_bytes","file_size_mib","file_type","file_type_base","file_type_guessed","is_gguf","is_model","kv_count","metadata_bytes","path","quantization","tensor_count"]
