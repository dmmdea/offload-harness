    "shards": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer"
        },
        "shards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              },
              "exists": {
                "type": "boolean"
              }
            },
            "required": ["bytes","exists","index","path"]
          }
        },
        "total_bytes": {
          "type": "integer"
        },
        "missing_shard_indexes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "complete": {
          "type": "boolean"
        },
        "convention": {
          "type": "string"
        }
      },
      "required": ["complete","convention","count","shards","total_bytes"]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_metadata_included": {
      "type": "boolean"
    }
  },
  "required": ["raw_metadata_included","resolved_from","schema_version","target"]
}
