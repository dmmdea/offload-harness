        },
        "rope_scaling": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "factor": {
              "type": "number"
            },
            "original_context_length": {
              "type": "integer"
            },
            "attn_factor": {
              "type": "number"
            },
            "yarn_log_multiplier": {
              "type": "number"
            },
            "yarn_ext_factor": {
              "type": "number"
            },
            "yarn_beta_fast": {
              "type": "number"
            },
            "yarn_beta_slow": {
              "type": "number"
