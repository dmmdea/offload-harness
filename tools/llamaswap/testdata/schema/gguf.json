        "quantization_profile": {
          "type": "object",
          "properties": {
            "tensors": {
              "type": "integer"
            },
            "elements": {
              "type": "integer"
            },
            "bytes": {
              "type": "integer"
            },
            "bits_per_weight": {
              "type": "number"
            },
            "types": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "tensors": {
                    "type": "integer"
                  },
                  "elements": {
                    "type": "integer"
                  },
                  "bytes": {
                    "type": "integer"
                  },
                  "bits_per_element": {
                    "type": "number"
                  },
                  "share_of_bytes": {
                    "type": "number"
                  }
                },
                "required": ["bits_per_element","bytes","elements","share_of_bytes","tensors","type"]
              }
            },
            "dominant_type": {
              "type": "string"
            },
            "declared_file_type": {
              "type": "string"
            },
            "label_mismatch": {
              "type": "boolean"
            },
            "label_mismatch_note": {
              "type": "string"
            },
            "unknown_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unsized_tensors": {
              "type": "integer"
            },
            "partial_shard": {
              "type": "boolean"
            }
          },
          "required": ["bits_per_weight","bytes","elements","label_mismatch","tensors","types"]
