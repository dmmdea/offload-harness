+func handleCodeOrchSearch(ctx context.Context, req mcplib.CallToolRequest) (*mcplib.CallToolResult, error) {
+	args := req.GetArguments()
+	query, ok := args["query"].(string)
+	if !ok || strings.TrimSpace(query) == "" {
+		return mcplib.NewToolResultError("query is required"), nil
+	}
+	limit := 10
+	if v, ok := args["limit"].(float64); ok && v > 0 {
+		limit = int(v)
+	}
+
+	terms := codeOrchKeywords("", "", query, "")
+	type scored struct {
+		ep    *codeOrchEndpoint
+		score int
+	}
+	results := make([]scored, 0, len(codeOrchEndpoints))
+	for i := range codeOrchEndpoints {
+		ep := &codeOrchEndpoints[i]
+		score := 0
+		for _, t := range terms {
+			for _, kw := range ep.keywords {
+				if kw == t {
+					score += 2
+				} else if strings.Contains(kw, t) || strings.Contains(t, kw) {
+					score++
+				}
+			}
+		}
+		if score > 0 {
+			results = append(results, scored{ep: ep, score: score})
+		}
+	}
+	sort.SliceStable(results, func(i, j int) bool { return results[i].score > results[j].score })
+	if len(results) > limit {
+		results = results[:limit]
+	}
+
+	out := make([]map[string]any, 0, len(results))
+	for _, r := range results {
+		item := codeOrchEndpointMetadata(r.ep)
+		item["score"] = r.score
+		out = append(out, item)
+	}
+	payload := map[string]any{"count": len(out), "results": out}
+	text, err := bound.JSON(payload)
+	if err != nil {
+		return mcplib.NewToolResultError(fmt.Sprintf("encoding search results: %v", err)), nil
+	}
+	// structuredContent carries the same payload the text content renders, so a
+	// host that reads the declared outputSchema never has to re-parse the text.
+	return mcplib.NewToolResultStructured(payload, text), nil
+}
+
+func handleCodeOrchGet(ctx context.Context, req mcplib.CallToolRequest) (*mcplib.CallToolResult, error) {
+	args := req.GetArguments()
+	id, ok := args["endpoint_id"].(string)
+	if !ok || id == "" {
+		return mcplib.NewToolResultError("endpoint_id is required (call comfyui_search first)"), nil
+	}
+	ep := findCodeOrchEndpoint(id)
+	if ep == nil {
+		return mcplib.NewToolResultError(fmt.Sprintf("unknown endpoint_id %q — call comfyui_search to discover valid ids", id)), nil
+	}
+	if ep.Method != "GET" {
+		return mcplib.NewToolResultError(fmt.Sprintf("endpoint_id %q is %s, but comfyui_get only permits GET endpoints", id, ep.Method)), nil
+	}
+	payload := codeOrchEndpointMetadata(ep)
+	text, err := bound.JSON(payload)
+	if err != nil {
+		return mcplib.NewToolResultError(fmt.Sprintf("encoding endpoint metadata: %v", err)), nil
+	}
+	return mcplib.NewToolResultStructured(payload, text), nil
+}
