# Line endings are not cosmetic for everything in this repo.
#
# A shell script checked out with CRLF fails at exec with "env: 'bash\r': No such
# file or directory" — a message that names neither the script nor the real cause.
# This repo is developed on Windows and deployed to Linux nodes, so that path is
# the normal one, not an edge case.
*.sh            text eol=lf
*.bash          text eol=lf

# Rendered onto Linux nodes and read by services there.
setup/templates/*.yaml  text eol=lf

# Generated files: keeping them LF means `go generate` produces no diff on a
# Windows checkout, so a no-op regeneration cannot look like a change.
docs/tiers/**   text eol=lf
config.example.json text eol=lf

# Printed CLIs (docs/systems/printed-clis.md) are generated trees vendored from the
# Printing Press, which emits LF. Same rationale as above, one step larger: a Windows
# checkout with autocrlf would rewrite all ~200 files to CRLF, and the next re-vendor
# would then diff the ENTIRE tree against an LF source — burying the real change. It
# also keeps spec.yaml byte-identical to the `spec_checksum` in .printing-press.json.
tools/**        text eol=lf
